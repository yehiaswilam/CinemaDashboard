@model MovieFormVM
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Movie" : "Add Movie";
}

<div class="page-header">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>

    <div class="row g-3">
        <!-- Left: details -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">Movie details</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="0">-- Select category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CinemaId" class="form-label"></label>
                            <select asp-for="CinemaId" asp-items="Model.Cinemas" class="form-select">
                                <option value="0">-- Select cinema --</option>
                            </select>
                            <span asp-validation-for="CinemaId" class="text-danger small"></span>
                            @if (!Model.Cinemas.Any())
                            {
                                <div class="small mt-1">No cinemas yet — <a asp-controller="Cinemas" asp-action="Create">add one first</a>.</div>
                            }
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<MovieStatus>()" class="form-select"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateTime" class="form-label"></label>
                            <input asp-for="DateTime" type="datetime-local" class="form-control" />
                            <span asp-validation-for="DateTime" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actors -->
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between">
                    <span>Actors</span>
                    <a asp-controller="Actors" asp-action="Create" class="small">+ New actor</a>
                </div>
                <div class="card-body">
                    @if (!Model.Actors.Any())
                    {
                        <p class="text-muted mb-0">No actors yet.</p>
                    }
                    else
                    {
                        <div class="actor-picker">
                            @foreach (var a in Model.Actors)
                            {
                                <label class="actor-option">
                                    <input type="checkbox" class="form-check-input" name="ActorIds" value="@a.Id"
                                           checked="@Model.ActorIds.Contains(a.Id)" />
                                    <img src="@a.Img" class="avatar" alt="" />
                                    <span class="small">@a.Name</span>
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: images -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">Main image</div>
                <div class="card-body">
                    <input asp-for="MainImgFile" type="file" accept="image/*" class="form-control" data-preview="#mainPreview" />
                    @if (isEdit)
                    {
                        <div class="form-text">Leave empty to keep the current image.</div>
                    }
                    <span asp-validation-for="MainImgFile" class="text-danger small"></span>
                    <img id="mainPreview" src="@Model.ExistingMainImg"
                         class="poster mt-2 @(string.IsNullOrEmpty(Model.ExistingMainImg) ? "d-none" : "")" alt="" />
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">Sub images</div>
                <div class="card-body">
                    @if (Model.ExistingSubImages.Any())
                    {
                        <div class="mb-2">
                            @foreach (var img in Model.ExistingSubImages)
                            {
                                <div class="sub-img-box">
                                    <img src="@img.Img" class="thumb-lg" alt="" />
                                    <label><input type="checkbox" name="RemoveSubImageIds" value="@img.Id" /> remove</label>
                                </div>
                            }
                        </div>
                    }
                    <input asp-for="SubImageFiles" type="file" multiple accept="image/*" class="form-control" data-preview-list="#subPreview" />
                    <div class="form-text">You can select several images at once.</div>
                    <span asp-validation-for="SubImageFiles" class="text-danger small"></span>
                    <div id="subPreview" class="mt-2"></div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-3">
                <i class="bi bi-check-lg"></i> @(isEdit ? "Save changes" : "Add movie")
            </button>
        </div>
    </div>
</form>
