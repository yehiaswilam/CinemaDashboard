@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";
    var maxCat = Model.MoviesPerCategory.Select(x => x.Count).DefaultIfEmpty(0).Max();
    var maxCinema = Model.MoviesPerCinema.Select(x => x.Count).DefaultIfEmpty(0).Max();
    int Pct(int value, int max) => max == 0 ? 0 : (int)Math.Round(value * 100.0 / max);
}

<div class="page-header">
    <h1>Dashboard</h1>
    <a asp-controller="Movies" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Movie</a>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Movies" asp-action="Index" class="card stat-card text-decoration-none text-body">
            <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-camera-reels"></i></div>
            <div><div class="stat-value">@Model.MoviesCount</div><div class="stat-label">Movies</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Categories" asp-action="Index" class="card stat-card text-decoration-none text-body">
            <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-tags"></i></div>
            <div><div class="stat-value">@Model.CategoriesCount</div><div class="stat-label">Categories</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Cinemas" asp-action="Index" class="card stat-card text-decoration-none text-body">
            <div class="stat-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-building"></i></div>
            <div><div class="stat-value">@Model.CinemasCount</div><div class="stat-label">Cinemas</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Actors" asp-action="Index" class="card stat-card text-decoration-none text-body">
            <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-people"></i></div>
            <div><div class="stat-value">@Model.ActorsCount</div><div class="stat-label">Actors</div></div>
        </a>
    </div>
</div>

<!-- Status breakdown -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-controller="Movies" asp-action="Index" asp-route-status="@MovieStatus.Available" class="card p-3 text-decoration-none text-body h-100">
            <div class="d-flex justify-content-between"><span class="stat-label">Now Showing</span><span class="badge @MovieStatus.Available.BadgeClass()">live</span></div>
            <div class="stat-value mt-2">@Model.AvailableCount</div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Movies" asp-action="Index" asp-route-status="@MovieStatus.Upcoming" class="card p-3 text-decoration-none text-body h-100">
            <div class="d-flex justify-content-between"><span class="stat-label">Upcoming</span><span class="badge @MovieStatus.Upcoming.BadgeClass()">soon</span></div>
            <div class="stat-value mt-2">@Model.UpcomingCount</div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Movies" asp-action="Index" asp-route-status="@MovieStatus.Expired" class="card p-3 text-decoration-none text-body h-100">
            <div class="d-flex justify-content-between"><span class="stat-label">Expired</span><span class="badge @MovieStatus.Expired.BadgeClass()">ended</span></div>
            <div class="stat-value mt-2">@Model.ExpiredCount</div>
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Next shows -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock me-1"></i> Next Shows</span>
                <a asp-controller="Movies" asp-action="Index" class="small">View all</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.NextShows.Any())
                {
                    <p class="text-muted text-center py-4 mb-0">No upcoming shows.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <tbody>
                            @foreach (var m in Model.NextShows)
                            {
                                <tr>
                                    <td style="width:60px"><img src="@m.MainImg" class="thumb" alt="" /></td>
                                    <td>
                                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id" class="fw-semibold text-decoration-none">@m.Name</a>
                                        <div class="small text-muted"><i class="bi bi-building"></i> @m.Cinema?.Name</div>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-semibold">@m.DateTime.ToString("dd MMM")</div>
                                        <div class="small text-muted">@m.DateTime.ToString("hh:mm tt")</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Movies per category -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-bar-chart me-1"></i> Movies per Category</div>
            <div class="card-body">
                @if (!Model.MoviesPerCategory.Any())
                {
                    <p class="text-muted text-center mb-0">No categories yet.</p>
                }
                @foreach (var c in Model.MoviesPerCategory)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1"><span>@c.Name</span><span class="fw-semibold">@c.Count</span></div>
                        <div class="bar"><span style="width:@Pct(c.Count, maxCat)%"></span></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Latest movies -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-stars me-1"></i> Recently Added</div>
            <ul class="list-group list-group-flush">
                @if (!Model.LatestMovies.Any())
                {
                    <li class="list-group-item text-muted text-center py-4">No movies yet.</li>
                }
                @foreach (var m in Model.LatestMovies)
                {
                    <li class="list-group-item d-flex align-items-center gap-2">
                        <img src="@m.MainImg" class="thumb" alt="" />
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@m.Name</div>
                            <div class="small text-muted">@m.Category?.Name · @m.Price.ToString("0.00") EGP</div>
                        </div>
                        <span class="badge @m.Status.BadgeClass()">@m.Status.Label()</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Cinemas -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-building me-1"></i> Movies per Cinema</div>
            <div class="card-body">
                @if (!Model.MoviesPerCinema.Any())
                {
                    <p class="text-muted text-center mb-0">No cinemas yet.</p>
                }
                @foreach (var c in Model.MoviesPerCinema)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1"><span>@c.Name</span><span class="fw-semibold">@c.Count</span></div>
                        <div class="bar"><span style="width:@Pct(c.Count, maxCinema)%"></span></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Top actors -->
    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-person-star me-1"></i> Top Actors</div>
            <ul class="list-group list-group-flush">
                @if (!Model.TopActors.Any())
                {
                    <li class="list-group-item text-muted text-center py-4">No actors yet.</li>
                }
                @foreach (var a in Model.TopActors)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@a.Name</span><span class="badge text-bg-light">@a.Count movies</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
