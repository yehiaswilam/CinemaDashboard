@model string?
@{
    ViewData["Title"] = "Check your email";
}

<div class="text-center">
    <i class="bi bi-envelope-paper display-5 text-primary"></i>
    <h1 class="h4 fw-bold mt-3">Check your email</h1>
    <p class="text-muted">
        If an account exists for <strong>@(string.IsNullOrEmpty(Model) ? "that address" : Model)</strong>,
        you'll get an email with a link to reset your password.
    </p>
    <a asp-action="Login" class="btn btn-primary">Back to sign in</a>
</div>
