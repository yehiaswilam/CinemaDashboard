@model LoginVM
@{
    ViewData["Title"] = "Sign in";
    var providers = ViewBag.ExternalProviders as List<ExternalProviderVM> ?? new List<ExternalProviderVM>();
}

<h1 class="h4 fw-bold mb-1">Welcome back</h1>
<p class="text-muted small mb-4">Sign in to your account.</p>

<form asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between">
            <label asp-for="Password" class="form-label"></label>
            <a asp-action="ForgotPassword" class="small">Forgot password?</a>
        </div>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary w-100">Sign in</button>
</form>

@if (providers.Any())
{
    <div class="auth-divider"><span>or</span></div>

    <form asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        @foreach (var p in providers)
        {
            <button type="submit" name="provider" value="@p.Name" class="btn btn-outline-secondary w-100 mb-2">
                <i class="bi bi-@p.Name.ToLowerInvariant() me-1"></i> Continue with @p.DisplayName
            </button>
        }
    </form>
}

<p class="text-center small mt-4 mb-1">
    No account? <a asp-action="Register">Create one</a>
</p>
<p class="text-center small mb-0">
    Didn't get the confirmation email? <a asp-action="ResendConfirmation" asp-route-email="@Model.Email">Resend it</a>
</p>
