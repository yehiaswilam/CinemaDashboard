@model ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot password";
}

<h1 class="h4 fw-bold mb-1">Forgot your password?</h1>
<p class="text-muted small mb-4">Enter your email and we'll send you a link to choose a new one.</p>

<form asp-action="ForgotPassword" method="post">
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Send reset link</button>
</form>

<p class="text-center small mt-4 mb-0"><a asp-action="Login">Back to sign in</a></p>
