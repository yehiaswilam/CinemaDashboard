@{
    ViewData["Title"] = "Access denied";
}

<div class="text-center">
    <i class="bi bi-shield-lock display-5 text-danger"></i>
    <h1 class="h4 fw-bold mt-3">Admins only</h1>
    <p class="text-muted">
        You're signed in as <strong>@User.Identity?.Name</strong>, but this page is only for admins.
    </p>

    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house"></i> Back to the site
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-left"></i> Use another account</button>
            </form>
        }
    </div>
</div>
