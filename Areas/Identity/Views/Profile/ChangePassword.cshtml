@model ChangePasswordVM
@{
    ViewData["Title"] = Model.HasPassword ? "Change password" : "Set a password";
}

<h1 class="h3 fw-bold mb-4">My account</h1>

<div class="row g-4">
    <div class="col-md-3">
        <partial name="_ProfileNav" />
    </div>

    <div class="col-md-9">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold mb-1">@ViewData["Title"]</h2>
                @if (!Model.HasPassword)
                {
                    <p class="text-muted small">You signed up with Google. Set a password if you also want to sign in with your email.</p>
                }

                <form asp-action="ChangePassword" method="post" class="mt-3" style="max-width:420px">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    @if (Model.HasPassword)
                    {
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label"></label>
                            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> @(Model.HasPassword ? "Update password" : "Set password")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
