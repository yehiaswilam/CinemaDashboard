@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<div class="list-group">
    <a asp-controller="Profile" asp-action="Index"
       class="list-group-item list-group-item-action @(action == "Index" ? "active" : "")">
        <i class="bi bi-person me-2"></i> Profile
    </a>
    <a asp-controller="Profile" asp-action="ChangePassword"
       class="list-group-item list-group-item-action @(action == "ChangePassword" ? "active" : "")">
        <i class="bi bi-key me-2"></i> Password
    </a>
</div>
