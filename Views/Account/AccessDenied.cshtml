@{
    ViewData["Title"] = "Access denied";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <i class="bi bi-shield-lock display-5 text-danger"></i>
    <h1 class="h4 fw-bold mt-3">Admins only</h1>
    <p class="text-muted">
        You're signed in as <strong>@User.Identity?.Name</strong>, but this account doesn't have admin access yet.
        Ask an admin to promote you from the <em>Users</em> page.
    </p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-left"></i> Sign in with another account</button>
        </form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Sign in</a>
    }
</div>
